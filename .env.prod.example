# ============================================
# AITestCraft Docker生产环境配置文件
# 版本: 2.0 (支持多LLM Provider)
# ============================================
# 使用说明：
# 1. 复制此文件为 .env: cp .env.prod.example .env
# 2. 填写所有配置项（特别是密码和API密钥）
# 3. 确保 .env 文件已添加到 .gitignore
# 4. 运行: docker-compose -f docker-compose.prod.yml up -d
# ============================================

# --------------------------------------------
# 【必需】MySQL 主数据库配置 (Prisma ORM 使用)
# --------------------------------------------
# MySQL root 密码（首次启动时设置，后续修改需要手动处理）
MYSQL_ROOT_PASSWORD=your_secure_root_password_here

# 应用数据库名称
MYSQL_DATABASE=aitestcraft

# 应用数据库用户
MYSQL_USER=aitestcraft

# 应用数据库密码（建议使用强密码）
MYSQL_PASSWORD=your_secure_database_password_here

# --------------------------------------------
# 【可选】外部 MySQL 数据库配置 (缺陷管理数据查询)
# 如果缺陷管理功能需要查询外部MySQL数据库，请配置以下项
# 如果不需要，可以注释掉或保持默认值
# --------------------------------------------
# 外部MySQL主机地址（可以是IP或域名）
MYSQL_HOST=

# 外部MySQL端口
MYSQL_PORT=3306

# 外部MySQL用户名
# MYSQL_USER=

# 外部MySQL密码
# MYSQL_PASSWORD=

# 外部MySQL数据库名
# MYSQL_DATABASE=

# --------------------------------------------
# 【可选】PostgreSQL 数据库配置 (缺陷管理使用)
# 如果缺陷管理功能需要查询PostgreSQL数据库，请配置以下项
# --------------------------------------------
# PostgreSQL主机地址
POSTGRES_HOST=

# PostgreSQL端口
POSTGRES_PORT=5432

# PostgreSQL用户名
POSTGRES_USER=

# PostgreSQL密码
POSTGRES_PASSWORD=

# PostgreSQL数据库名
POSTGRES_DATABASE=

# --------------------------------------------
# 【必需】LLM Provider 选择
# --------------------------------------------
# 默认LLM Provider: deepseek | volcano-coding
# deepseek: 深度求索，通用大模型
# volcano-coding: 火山引擎Coding Plan，代码专用模型
LLM_PROVIDER=deepseek

# --------------------------------------------
# 【必需】DeepSeek API 配置
# --------------------------------------------
# DeepSeek API密钥（使用DeepSeek时必需）
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# DeepSeek API地址（一般不需要修改）
DEEPSEEK_API_URL=https://api.deepseek.com/v1

# --------------------------------------------
# 【可选】火山引擎 Coding Plan 配置
# --------------------------------------------
# 火山引擎API密钥（使用volcano-coding时必需）
VOLCANO_API_KEY=your_volcano_api_key_here

# 火山引擎Coding Plan基础URL（一般不需要修改）
VOLCANO_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3

# 火山引擎模型名称
VOLCANO_MODEL=ark-code-latest

# --------------------------------------------
# 【可选】LLM 通用配置
# --------------------------------------------
# LLM模型类型 (DeepSeek默认模型)
LLM_MODEL=deepseek-chat

# LLM温度参数 (0-1，越小越确定)
LLM_TEMPERATURE=0.3

# LLM请求超时时间（毫秒）
LLM_TIMEOUT=120000

# LLM最大重试次数
LLM_MAX_RETRIES=3

# LLM重试延迟（毫秒）
LLM_RETRY_DELAY=2000

# LLM批处理大小（同时生成的测试用例数）
LLM_BATCH_SIZE=5

# --------------------------------------------
# 【必需】JWT密钥配置
# --------------------------------------------
# JWT密钥（必需，用于用户认证令牌加密）
# 生产环境请使用强随机字符串，例如: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key_change_in_production

# --------------------------------------------
# 【必需】前端访问配置
# --------------------------------------------
# 前端访问地址（部署后用户访问的地址）
# 如果使用域名：FRONTEND_URL=http://your-domain.com
# 如果使用IP：FRONTEND_URL=http://your-server-ip
FRONTEND_URL=http://localhost

# 前端API地址（用于构建时注入）
# 如果前端和后端在同一服务器，使用服务器IP或域名
VITE_API_URL=http://localhost:9000

# WebSocket地址
VITE_SOCKET_URL=http://localhost:9000

# --------------------------------------------
# 【可选】应用配置
# --------------------------------------------
# 日志级别: debug, info, warn, error
LOG_LEVEL=info

# 文件上传大小限制
MAX_FILE_SIZE=10MB

# --------------------------------------------
# 【可选】缺陷管理配置
# --------------------------------------------
# 我的待办页面：分配给的用户ID
TODO_ASSIGNED_TO_ID=130

# 我的待办页面：已解决状态ID
TODO_RESOLVED_STATUS_ID=5

# --------------------------------------------
# 【可选】Server酱消息推送配置
# --------------------------------------------
# Server酱SendKey（用于消息推送，可选）
SERVERCHAN_SEND_KEY=

# ============================================
# 部署检查清单
# ============================================
# □ 已修改所有密码（不要使用默认值）
# □ 已配置至少一个LLM Provider的API密钥（DeepSeek或火山引擎）
# □ 已选择默认LLM Provider (LLM_PROVIDER)
# □ 已配置外部数据库（如需要缺陷管理功能）
# □ 已修改FRONTEND_URL为实际访问地址
# □ 已修改VITE_API_URL为实际后端地址
# □ 已将 .env 添加到 .gitignore
# □ 已准备数据库初始化SQL文件（首次部署）
# □ 已开放服务器防火墙端口 80 和 9000
# ============================================
