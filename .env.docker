# ============================================
# AITestCraft Docker生产环境配置文件
# 版本: 2.0 (支持多LLM Provider)
# 生成时间: 2026-04-30
# ============================================
# 使用说明：
# 1. 此文件包含敏感信息，已添加到 .gitignore
# 2. 如需修改配置，请编辑此文件后重启服务：
#    docker-compose -f docker-compose.prod.yml restart
# ============================================

# --------------------------------------------
# 【必需】MySQL 主数据库配置 (Prisma ORM 使用)
# --------------------------------------------
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=aitestcraft
MYSQL_USER=aitestcraft
MYSQL_PASSWORD=aitestcraft123

# --------------------------------------------
# 【可选】外部 MySQL 数据库配置
# 注：当前配置与主数据库相同，所有MySQL操作使用主数据库
# --------------------------------------------
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=aitestcraft
MYSQL_PASSWORD=aitestcraft123
MYSQL_DATABASE=aitestcraft

# --------------------------------------------
# 【必需】PostgreSQL 数据库配置 (缺陷管理使用)
# --------------------------------------------
POSTGRES_HOST=10.20.42.40
POSTGRES_PORT=25432
POSTGRES_USER=redmine_ro
POSTGRES_PASSWORD=readonly_pass
POSTGRES_DATABASE=redmine_production

# --------------------------------------------
# 【必需】LLM Provider 选择
# --------------------------------------------
# 默认LLM Provider: deepseek | volcano-coding
LLM_PROVIDER=deepseek

# --------------------------------------------
# 【必需】DeepSeek API 配置
# --------------------------------------------
DEEPSEEK_API_KEY=sk-c147b25dfb42489d930739e989a343ff
DEEPSEEK_API_URL=https://api.deepseek.com/v1

# --------------------------------------------
# 【可选】火山引擎 Coding Plan 配置
# --------------------------------------------
VOLCANO_API_KEY=
VOLCANO_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
VOLCANO_MODEL=ark-code-latest

# --------------------------------------------
# 【可选】LLM 通用配置
# --------------------------------------------
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=120000
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY=2000
LLM_BATCH_SIZE=5

# --------------------------------------------
# 【必需】前端访问配置
# 注意：部署到服务器后，请将 localhost 替换为实际服务器IP
# --------------------------------------------
FRONTEND_URL=http://localhost
VITE_API_URL=http://localhost:9000
VITE_SOCKET_URL=http://localhost:9000

# --------------------------------------------
# 【必需】JWT密钥配置
# --------------------------------------------
# JWT密钥（必需，用于用户认证令牌加密）
# 生产环境请使用强随机字符串
JWT_SECRET=aitestcraft-jwt-secret-key-change-in-production-2026

# --------------------------------------------
# 【可选】应用配置
# --------------------------------------------
LOG_LEVEL=info
MAX_FILE_SIZE=10MB

# --------------------------------------------
# 【可选】缺陷管理配置
# --------------------------------------------
TODO_ASSIGNED_TO_ID=130
TODO_RESOLVED_STATUS_ID=5

# --------------------------------------------
# 【可选】Server酱消息推送配置
# --------------------------------------------
SERVERCHAN_SEND_KEY=

# ============================================
# 部署后需要修改的配置（如果使用服务器IP访问）
# ============================================
# 如果使用服务器IP访问（例如 http://192.168.1.100），
# 请修改以下配置并重启服务：
#
# FRONTEND_URL=http://your-server-ip
# VITE_API_URL=http://your-server-ip:9000
# VITE_SOCKET_URL=http://your-server-ip:9000
#
# 然后执行：
# docker-compose -f docker-compose.prod.yml up -d --build
# ============================================
