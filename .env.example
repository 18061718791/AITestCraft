# ============================================
# AITestCraft Docker部署环境变量配置
# ============================================

# --------------------------------------------
# MySQL数据库配置
# --------------------------------------------
MYSQL_ROOT_PASSWORD=your_root_password
MYSQL_DATABASE=aitestcraft
MYSQL_USER=aitestcraft
MYSQL_PASSWORD=your_database_password

# --------------------------------------------
# DeepSeek API配置 (必需)
# --------------------------------------------
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_URL=https://api.deepseek.com/v1

# --------------------------------------------
# OpenCode Go API配置 (推荐用于图片解析)
# --------------------------------------------
# OpenCode Go 提供低成本的 kimi-k2.6 等视觉模型访问
# 订阅地址: https://opencode.ai/auth
# 配置后，上传图片时将优先使用 kimi-k2.6 解析图片内容
OPENCODE_GO_API_KEY=your_opencode_go_api_key_here

# --------------------------------------------
# 后端服务配置
# --------------------------------------------
# JWT密钥（必需，用于用户认证令牌加密）
# 生产环境请使用强随机字符串，例如: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key_here

# 日志级别: debug, info, warn, error
LOG_LEVEL=info

# 文件上传大小限制
MAX_FILE_SIZE=10MB

# --------------------------------------------
# 缺陷管理配置
# --------------------------------------------
# 我的待办页面：分配给的用户ID
TODO_ASSIGNED_TO_ID=130

# 我的待办页面：已解决状态ID
TODO_RESOLVED_STATUS_ID=5

# --------------------------------------------
# 前端配置
# --------------------------------------------
# 如果使用域名或服务器IP，请修改以下配置
# 例如: VITE_API_URL=http://your-server-ip:9000
VITE_API_URL=http://localhost:9000
VITE_SOCKET_URL=http://localhost:9000

# --------------------------------------------
# 部署说明
# --------------------------------------------
# 1. 复制此文件为 .env: cp .env.example .env
# 2. 修改所有密码和API密钥
# 3. 如果使用云服务器，将 localhost 替换为服务器公网IP
# 4. 确保防火墙开放 80 和 9000 端口
# 5. 运行: docker-compose up -d
#
# 重要提示：
# - 首次部署前，需要将数据库初始化SQL文件放入 docker/mysql-init/ 目录
# - 可以从开发环境导出数据：scripts\export-mysql-data.bat -p your_password
# - 确保 .env 文件已添加到 .gitignore，不要提交到版本控制
